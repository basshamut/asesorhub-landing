---
const testimonials = [
	{
		name: "María González",
		company: "TechStart",
		quote: "Las asesorías de AsesoriaPro transformaron completamente nuestro enfoque de negocio. ¡Increíble experiencia!"
	},
	{
		name: "Carlos Rodríguez",
		company: "GreenSolutions",
		quote: "Gracias a su expertise en finanzas, logramos optimizar nuestros recursos y aumentar la rentabilidad."
	}
];
---

<section class="bg-gray-100 py-20">
	<div class="container mx-auto px-6">
		<h2 class="text-3xl font-bold text-center text-gray-800 mb-8">Lo que Dicen Nuestros Clientes</h2>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			{testimonials.map(testimonial => (
				<div class="bg-white rounded-lg shadow-md p-6">
					<p class="text-gray-600 mb-4">"{testimonial.quote}"</p>
					<div class="font-semibold">{testimonial.name}</div>
					<div class="text-sm text-gray-500">{testimonial.company}</div>
				</div>
			))}
		</div>
	</div>
</section>

