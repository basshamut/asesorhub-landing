---
const features = [
	{
		title: "Perfiles Personalizados",
		description: "Crea tu perfil detallado como consultor o encuentra el asesor perfecto como consultante.",
		icon: "user"
	},
	{
		title: "Reservas Flexibles",
		description: "Sistema de reservas fácil de usar con opciones de disponibilidad y precios personalizables.",
		icon: "calendar"
	},
	{
		title: "Pagos Seguros",
		description: "Transacciones seguras con Stripe, garantizando la protección tanto para consultores como consultantes.",
		icon: "credit-card"
	},
	{
		title: "Calificaciones y Reseñas",
		description: "Sistema de calificaciones y opiniones para construir confianza y reputación en la plataforma.",
		icon: "star"
	}
];
---

<section id="features" class="py-20 bg-white">
	<div class="container mx-auto px-6">
		<h2 class="text-3xl font-bold text-center text-gray-800 mb-8">Características Principales</h2>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
			{features.map(feature => (
				<div class="bg-gray-50 rounded-lg shadow-md p-6 text-center">
					<div class="text-4xl text-blue-600 mb-4">
						<i class={`fas fa-${feature.icon}`}></i>
					</div>
					<h3 class="text-xl font-semibold mb-2">{feature.title}</h3>
					<p class="text-gray-600">{feature.description}</p>
				</div>
			))}
		</div>
	</div>
</section>

